    top:31%;
    width:86%;
    padding:0;
  }

  .hero-content h1{
    margin:0;
    font-size:clamp(38px,10.3vw,52px);
    line-height:1.30;
    letter-spacing:.02em;
    font-weight:500;
    color:#54244f;
    text-shadow:
      0 1px 0 rgba(255,255,255,.75),
      0 3px 16px rgba(255,255,255,.45);
  }

  .hero-content h1 span{
    display:block;
    color:#54244f;
  }

  /* 金色細線 */
  .hero-content .line{
    width:72px;
    height:2px;
    margin:18px 0 13px;
    background:#b58a46;
  }

  /* 經文 */
  .verse{
    font-size:17px;
    letter-spacing:.12em;
