/* =========================================
   HSLLLC DAILY SECTION v1
   每日神話 / 每日靈泉 / 講道影音
   ========================================= */

.daily-section{
  position:relative;
  z-index:10;
  background:#faf7f2;
  padding:58px 6vw 70px;
  overflow:hidden;
}

/* 很淡的紫色光暈 */
.daily-section::before{
  content:"";
  position:absolute;
  width:280px;
  height:280px;
  border-radius:50%;
  top:-120px;
  right:-120px;
  background:rgba(116,55,112,.07);
  pointer-events:none;
}

.section-heading{
  position:relative;
  z-index:2;
  margin-bottom:34px;
}

.section-heading small{
  display:block;
  margin-bottom:10px;
  font-size:11px;
  letter-spacing:.22em;
  color:#b08a4d;
}

.section-heading h2{
  margin:0;
  max-width:320px;
  font-size:28px;
  line-height:1.45;
  font-weight:500;
  letter-spacing:.04em;
  color:#54244f;
}

.section-heading i{
  display:block;
  width:46px;
  height:2px;
  margin:17px 0 15px;
  background:#b58a46;
}

.section-heading p{
  margin:0;
  font-size:15px;
  line-height:1.8;
  letter-spacing:.04em;
  color:#776d68;
}


/* 三張內容卡 */

.daily-grid{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:1fr;
  gap:15px;
}

.daily-item{
  position:relative;
  display:block;
  min-height:178px;
  padding:25px 24px 23px;

  text-decoration:none;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.96),
      rgba(249,244,238,.92)
    );

  border:1px solid rgba(181,138,70,.25);
  border-radius:22px;

  box-shadow:
    0 10px 30px rgba(72,45,62,.06);

  overflow:hidden;

  transition:
    transform .28s ease,
    box-shadow .28s ease,
    border-color .28s ease;
}

.daily-item::after{
  content:"";
  position:absolute;
  right:-38px;
  bottom:-52px;
  width:135px;
  height:135px;
  border-radius:50%;
  background:rgba(93,35,87,.045);
}

.daily-item:active{
  transform:scale(.985);
}

.daily-number{
  position:absolute;
  top:17px;
  right:21px;

  font-family:Georgia,serif;
  font-size:42px;
  font-weight:400;
  line-height:1;

  color:rgba(84,36,79,.09);
}

.daily-item small{
  display:block;
  margin-bottom:8px;

  font-size:10px;
  letter-spacing:.18em;

  color:#b08a4d;
}

.daily-item h3{
  margin:0 0 9px;

  font-size:25px;
  line-height:1.3;
  font-weight:500;
  letter-spacing:.08em;

  color:#54244f;
}

.daily-item p{
  margin:0 0 19px;

  font-size:14px;
  line-height:1.65;
  letter-spacing:.03em;

  color:#766d68;
}

.daily-item b{
  position:relative;
  z-index:2;

  font-size:13px;
  font-weight:400;
  letter-spacing:.06em;

  color:#8b6836;
}


/* 手機較小尺寸 */

@media (max-width:390px){

  .daily-section{
    padding:
      50px
      6vw
      60px;
  }

  .section-heading h2{
    font-size:25px;
  }

  .daily-item{
    min-height:166px;
    padding:22px 21px;
    border-radius:20px;
  }

  .daily-item h3{
    font-size:23px;
  }

  .daily-number{
    font-size:38px;
  }
}


/* 桌機 */

@media (min-width:769px){

  .daily-section{
    padding:
      90px
      max(7vw,60px)
      100px;
  }

  .section-heading{
    max-width:600px;
    margin-bottom:45px;
  }

  .section-heading h2{
    max-width:none;
    font-size:38px;
  }

  .daily-grid{
    grid-template-columns:
      repeat(3,1fr);

    gap:22px;
  }

  .daily-item{
    min-height:220px;
    padding:30px;
  }

  .daily-item:hover{
    transform:translateY(-6px);

    border-color:
      rgba(181,138,70,.55);

    box-shadow:
      0 18px 38px
      rgba(72,45,62,.11);
  }
}


/* =========================================
   HSLLLC QUICK ACCESS v2
   ========================================= */

.home-quick{
  position:relative;
  z-index:12;

  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;

  padding:18px 4vw 22px;

  background:#faf7f2;
  border-bottom:1px solid rgba(181,138,70,.15);
}

.quick-item{
  min-width:0;
  min-height:118px;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  padding:13px 5px;

  text-align:center;
  text-decoration:none;

  background:rgba(255,255,255,.72);

  border:1px solid rgba(181,138,70,.20);
  border-radius:15px;

  box-shadow:
    0 5px 16px rgba(72,45,62,.045);

  transition:
    transform .25s ease,
    box-shadow .25s ease;
}

.quick-item:active{
  transform:scale(.97);
}

.quick-icon{
  height:34px;

  display:flex;
  align-items:center;
  justify-content:center;

  margin-bottom:7px;

  font-family:Georgia,serif;
  font-size:30px;
  line-height:1;
  font-weight:300;

  color:#b17c25;
}

.quick-item strong{
  display:block;

  margin-bottom:5px;

  font-size:15px;
  line-height:1.3;
  font-weight:500;
  letter-spacing:.03em;

  color:#4f3547;
}

.quick-item small{
  display:block;

  font-size:10px;
  line-height:1.4;
  letter-spacing:.02em;

  color:#978b83;
}


/* 小手機 */

@media(max-width:390px){

  .home-quick{
    gap:8px;
    padding:
      16px
      3.5vw
      20px;
  }

  .quick-item{
    min-height:108px;
    padding:11px 4px;
  }

  .quick-icon{
    font-size:27px;
  }

  .quick-item strong{
    font-size:14px;
  }

  .quick-item small{
    font-size:9px;
  }
}


/* 桌機：六個橫排 */

@media(min-width:769px){

  .home-quick{
    grid-template-columns:repeat(6,1fr);

    gap:12px;

    padding:
      24px
      max(4vw,40px)
      28px;
  }

  .quick-item{
    min-height:135px;
  }

  .quick-item:hover{
    transform:translateY(-4px);

    box-shadow:
      0 12px 25px
      rgba(72,45,62,.09);
  }
}


/* HSLLLC GOLD LINE ICONS */

.quick-icon svg{
  width:34px;
  height:34px;

  fill:none;
  stroke:#b17c25;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}


/* =========================================
   HSLLLC PHOTO CONTENT CARDS v1
   ========================================= */

.daily-grid{
  gap:20px;
}

.daily-item{
  padding:0;
  min-height:0;
  background:#fffdf9;
  border:1px solid rgba(181,138,70,.28);
  border-radius:22px;
  overflow:hidden;

  box-shadow:
    0 12px 30px rgba(72,45,62,.07);
}

/* 關閉舊卡片右下裝飾圓 */
.daily-item::after{
  display:none;
}

/* 照片 */

.daily-photo{
  position:relative;
  width:100%;
  height:210px;
  overflow:hidden;
  background:#eee8df;
}

.daily-photo::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      to bottom,
      rgba(45,25,35,0) 50%,
      rgba(45,25,35,.18) 100%
    );
}

.daily-photo img{
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  object-position:center;

  transition:transform .5s ease;
}


/* 下半部文字 */

.daily-body{
  position:relative;
  min-height:170px;
  padding:24px 25px 26px;
  box-sizing:border-box;
  background:#fffdf9;
}

.daily-body .daily-number{
